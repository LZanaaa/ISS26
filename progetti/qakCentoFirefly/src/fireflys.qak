System fireflys

//Event flash : flash(V, T)
Dispatch cellstate : cellstate(X, Y, S) 
Event flash: flash(id)


Context ctxfirefly ip [ host= "localhost" port=8011 ]
Context ctxgrid ip [host="127.0.0.1" port=8050 ]

ExternalQActor griddisplay context ctxgrid

QActor fireflyfactory context ctxfirefly {
	[# var NUM = 1 #] 
	
	State s0 initial {

	}
	Goto createFirefly
	
	State createFirefly {
		[# val MyName = "firefly_$NUM" #]
		create firefly _"$NUM"
		[# 
			if(NUM == 400){ while(true){}} 
			else NUM++ 
		#]
	}
	
	
	Goto createFirefly
}

QActor firefly context ctxfirefly dynamicOnly{
	
	//Valori iniziali casuali
	[#	
		var LINELEN = 20		
		val id = name.split('_').last().toInt()		
        var X    = id % LINELEN
        var Y	 = id / LINELEN
    	var T_On  = 0L
       	var T_Off = 0L
    #]
	
	//Stato 0 spenta
	State s0 initial{
		println("name | viva") color green		
		
		
	}
	Goto spenta
	
	State spenta{
		//println("$name | spenta") color cyan
		[#
	        T_On  = (100..700).random().toLong() 
	        T_Off = (500..1000).random().toLong()
    	#]
    	forward griddisplay -m cellstate : cellstate($X, $Y, 0) 
    	delayVar T_Off
	}
	Goto accesa
		
	State accesa{
		//println("$name | accesa") color yellow
		//emit flash : flash($ID, $T_On)ù
		 //forward mockobserver -m flash : arg($X, $Y, $T_On) griddisplay
		 
		 forward griddisplay -m cellstate : cellstate($X, $Y, 1) 
		 delayVar T_On
	}		
	
	Goto spenta
	
	
}

