System fireflysync

Event extflash: extflash(id)

Context ctxfireflysync ip [ host= "localhost" port=8011 ]
Context ctxgrid ip [host="127.0.0.1" port=8050 ]

ExternalQActor griddisplay context ctxgrid

QActor fireflyfactory context ctxfireflysync {
	[# var NUM = 1 #] 
	
	State s0 initial {

	}
	Goto createFirefly
	
	State createFirefly {
		[# val MyName = "firefly_$NUM" #]
		create firefly _"$NUM"
		
		[# NUM++ #]

	}
	
	Goto createFirefly if [# NUM <= 3 #] else stop
	
	State stop{
		println("$name | Lucciole create") color green
		//do nothing
	}
}


QActor firefly context ctxfireflysync dynamicOnly{
	
	//Valori iniziali casuali
	[#	
		var LINELEN = 20		
		val id = name.split('_').last().toInt()		
        var X    = id % LINELEN
        var Y	 = id / LINELEN
    	var T_On = 0L
       	var T_Off = 0L
    #]
    
    State s0 initial{
    	[#
    		T_On = 	(560..3000).random().toLong() 
    		T_Off = (560..3000).random().toLong() 
    	#]
    }
    
    Goto spenta
    
    State spenta{
    	//Stato spento
    	println("Spento")
    	[##]
    }
    
    Transition t0
    	whenTimeVar T_Off -> accesa
		whenEvent extflash -> update
    
    State accesa{
    	println("Acceso")
    }
    
    Transition t
    	whenTimeVar T_On -> spenta
    
    State update{
    	onMsg( extflash : extflash(ID) ) {
    		[# 
    			
            #]
    	}
    }
    
    Goto spenta
    
}